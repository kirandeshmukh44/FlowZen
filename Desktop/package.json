{
  "name": "flowzen-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "FlowZen desktop app - React + Express + MongoDB",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.flowzen.app",
    "productName": "FlowZen",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html"
    ],
    "extraResources": [
      {
        "from": "../Server",
        "to": "Server",
        "filter": [
          "**/*",
          "!.env",
          "!node_modules/.cache/**"
        ]
      },
      {
        "from": "../Client/dist",
        "to": "Client/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "FlowZen-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
