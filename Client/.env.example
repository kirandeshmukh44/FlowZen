# Backend API base URL (mounted under /api in Server/server.js)
VITE_API_URL=http://localhost:5000/api

# Set to 'true' ONLY for offline demos: falls back to bundled mock data
# when the API is unreachable. Any HTTP error response (400/401/403/500)
# is always shown to the user and never falls back.
VITE_USE_MOCK=false
